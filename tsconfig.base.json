{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "declaration": true,
    "sourceMap": true,
    "baseUrl": ".",
    "paths": {
      "@atendimentooffline/enterprise-ui": ["packages/ui/src"],
      "@atendimentooffline/enterprise-layout": ["packages/enterprise-layout/src"],
      "@atendimentooffline/enterprise-theme": ["packages/enterprise-theme/src"],
      "@atendimentooffline/enterprise-shell": ["packages/enterprise-shell/src"],
      "@atendimentooffline/enterprise-sdk": ["packages/enterprise-sdk/src"],
      "@atendimentooffline/enterprise-components": ["packages/enterprise-components/src"],
      "@atendimentooffline/enterprise-hooks": ["packages/enterprise-hooks/src"],
      "@atendimentooffline/enterprise-icons": ["packages/enterprise-icons/src"],
      "@atendimentooffline/contracts": ["packages/contracts/src/index.ts"],
      "@atendimentooffline/api": ["packages/api/src/index.ts"]
    }
  },
  "exclude": ["node_modules", "dist", "build"]
}
